# Headers match the FFmpeg 7.1.2 DLLs shipped by the tested Qt kit.
# Build MSVC import libraries from public exported symbols; no additional runtime.
if(NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "This FFmpeg integration requires Windows MSVC x64.")
endif()
get_target_property(qt_core_dll Qt6::Core IMPORTED_LOCATION_RELEASE)
get_filename_component(ffmpeg_bin "${qt_core_dll}" DIRECTORY)
foreach(dll IN ITEMS avcodec-61 avformat-61 avutil-59 swresample-5)
  if(NOT EXISTS "${ffmpeg_bin}/${dll}.dll")
    message(FATAL_ERROR "Missing ${dll}.dll in Qt bin. Use the tested Qt 6.10.2 MSVC x64 kit with FFmpeg 7.1.x.")
  endif()
endforeach()
set(ff_avcodec avcodec_find_decoder avcodec_alloc_context3 avcodec_parameters_to_context avcodec_open2 avcodec_free_context avcodec_send_packet avcodec_receive_frame avcodec_flush_buffers avcodec_parameters_alloc avcodec_parameters_copy avcodec_parameters_free av_packet_alloc av_packet_free av_packet_clone av_packet_unref)
set(ff_avformat avformat_alloc_context avformat_open_input avformat_find_stream_info av_find_best_stream av_read_frame avformat_close_input avio_alloc_context avio_context_free)
set(ff_avutil av_malloc av_free av_frame_alloc av_frame_free av_frame_unref av_strerror av_rescale_q av_channel_layout_default av_channel_layout_uninit av_opt_set_int)
set(ff_swresample swr_alloc_set_opts2 swr_init swr_free swr_convert swr_get_out_samples swr_get_delay swr_close)
foreach(spec IN ITEMS "avcodec-61" "avformat-61" "avutil-59" "swresample-5")
  string(REGEX REPLACE "-[0-9]+$" "" component "${spec}")
  set(def "LIBRARY ${spec}.dll\nEXPORTS\n")
  foreach(symbol IN LISTS ff_${component})
    string(APPEND def "${symbol}\n")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/${component}.def" "${def}")
  execute_process(COMMAND "${CMAKE_AR}" /nologo /machine:x64 "/def:${CMAKE_BINARY_DIR}/${component}.def" "/out:${CMAKE_BINARY_DIR}/${component}.lib" RESULT_VARIABLE result OUTPUT_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot create FFmpeg import library: ${component}")
  endif()
  add_library(FFmpeg::${component} SHARED IMPORTED)
  set_target_properties(FFmpeg::${component} PROPERTIES IMPORTED_IMPLIB "${CMAKE_BINARY_DIR}/${component}.lib")
endforeach()
